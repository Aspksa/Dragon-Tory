TOORU_APP_NAME=Dragon Tory
TOORU_HOST=127.0.0.1
TOORU_PORT=8787
TOORU_DATA_DIR=./data

TOORU_DEEPSEEK_API_KEY=
TOORU_DEEPSEEK_BASE_URL=https://foundation-models.api.cloud.ru/v1
TOORU_DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash
TOORU_DEEPSEEK_TIMEOUT_SECONDS=45
TOORU_DEEPSEEK_MAX_ATTEMPTS=3
TOORU_DEEPSEEK_RETRY_BASE_SECONDS=0.6
TOORU_DEEPSEEK_RETRY_MAX_SECONDS=5
TOORU_DEEPSEEK_CIRCUIT_BREAKER_FAILURES=5
TOORU_DEEPSEEK_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Safety default: keep the HTTP API on loopback until remote auth is implemented.
TOORU_ALLOW_REMOTE_API=false

# Local System Brain telemetry. Prompt/document bodies are not stored here.
TOORU_OBSERVABILITY_RETENTION_DAYS=30

# Cognitive Core VIII: bounded policy learning + proactive local scan.
TOORU_COGNITION_AUTOMATION_ENABLED=true
TOORU_COGNITION_INTERVAL_SECONDS=900

TOORU_UPDATE_REPOSITORY=Aspksa/Dragon-Tory
TOORU_UPDATE_BRANCH=main
# Optional. Useful for private repositories or higher GitHub API rate limits.
TOORU_UPDATE_GITHUB_TOKEN=

TOORU_MEMORY_EMBEDDING_PROVIDER=hash
TOORU_MEMORY_EMBEDDING_DIMENSIONS=384
TOORU_MEMORY_EMBEDDING_URL=
TOORU_MEMORY_EMBEDDING_API_KEY=
TOORU_MEMORY_EMBEDDING_MODEL=
TOORU_MEMORY_RELATED_THRESHOLD=0.82

TOORU_MEMORY_AUTOMATION_ENABLED=true
TOORU_MEMORY_MAINTENANCE_INTERVAL_SECONDS=1800
TOORU_MEMORY_ARCHIVE_AFTER_DAYS=180
TOORU_MEMORY_ARCHIVE_MAX_IMPORTANCE=0.30
TOORU_MEMORY_ARCHIVE_MAX_ACCESS_COUNT=1
TOORU_MEMORY_AUTO_CONSOLIDATE_THRESHOLD=40
TOORU_MEMORY_CONSOLIDATE_COOLDOWN_HOURS=24

TOORU_MEMORY_INTELLIGENCE_REVIEWER_THRESHOLD=0.85
TOORU_MEMORY_INTELLIGENCE_CONTEXT_LIMIT=12

TOORU_MEMORY_GUARDIAN_ENABLED=true
TOORU_MEMORY_GUARDIAN_MEDIUM_IMPORTANCE=0.65
TOORU_MEMORY_GUARDIAN_HIGH_IMPORTANCE=0.85
TOORU_MEMORY_GUARDIAN_MIN_CONFIDENCE=0.60

TOORU_MEMORY_GUARDIAN_AUTOMATION_ENABLED=true
TOORU_MEMORY_GUARDIAN_INTERVAL_SECONDS=900
TOORU_MEMORY_GUARDIAN_RETRY_BATCH_SIZE=20
TOORU_MEMORY_GUARDIAN_MAX_ATTEMPTS=5
TOORU_MEMORY_GUARDIAN_RETRY_DELAY_SECONDS=1800
